{
  pkgs,
  lib ? pkgs.lib,
}: let
  eval = lib.evalModules {
    modules = [
      ./module.nix
      {
        # only the option declarations are needed; skip definitions of NixOS options (users, systemd, ...)
        _module.check = false;
        _module.args.pkgs = pkgs;
      }
    ];
  };
  root = toString ./.;
  optionsDoc = pkgs.nixosOptionsDoc {
    options = removeAttrs eval.options ["_module"];
    # link declarations to repo-relative files instead of nixpkgs
    transformOptions = opt:
      opt
      // {
        declarations =
          map (decl: let
            file = lib.removePrefix "/" (lib.removePrefix root (toString decl));
          in {
            name = file;
            url = file;
          })
          opt.declarations;
      };
  };
in
  pkgs.runCommand "vproxy-options-doc" {} ''
    mkdir -p $out
    {
      printf '# NixOS module options\n\n'
      printf '<!-- Generated by docs.nix; regenerate with: nix build .#docs && install -m 0644 result/options.md OPTIONS.md -->\n\n'
      cat ${optionsDoc.optionsCommonMark}
    } > $out/options.md
    cp ${optionsDoc.optionsJSON}/share/doc/nixos/options.json $out/options.json
  ''
